{
  "name": "chucks-tools-suite",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "description": "Suite de herramientas locales para archivos",
  "author": {
    "name": "CHUCK",
    "email": "chuck@tools.local"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=26.9.0",
    "npm": ">=11.19.1"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build": "tsc && vite build",
    "start": "electron .",
    "test": "node --test",
    "lint": "eslint src vite.config.ts",
    "lint:fix": "eslint src vite.config.ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm test && npm run lint && npm run format:check && npm run build",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "pack": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "7zip-min": "latest",
    "cheerio": "latest",
    "clipboard-event": "^1.6.0",
    "handbrake-js": "8.0.2",
    "node-downloader-helper": "2.1.11",
    "normalize-url": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tldts": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "globals": "latest",
    "prettier": "latest",
    "typescript": "6.0.3",
    "typescript-eslint": "latest",
    "wait-on": "latest"
  },
  "allowScripts": {
    "handbrake-js@8.0.2": true
  },
  "build": {
    "appId": "com.chuck.toolssuite",
    "productName": "CHUCK's Tools Suite",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "vendor/**"
    ],
    "asarUnpack": [
      "**/node_modules/handbrake-js/**",
      "**/node_modules/7zip-bin/**",
      "**/node_modules/clipboard-event/**",
      "vendor/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
